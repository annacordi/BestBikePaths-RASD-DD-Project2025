<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.6.1">
  <collaboration id="Collab_TripReview">
    <participant id="System" name="BBP System" processRef="Process_System" />
    <participant id="User" name="Registered User" processRef="Process_User" />
    <messageFlow id="Flow_ObstacleToUser" sourceRef="Task_SendObstacle" targetRef="Event_ReceiveObstacle" />
    <messageFlow id="Flow_ConfirmToSystem" sourceRef="Task_ConfirmObstacle" targetRef="Event_ReceiveDecision" />
    <messageFlow id="Flow_FinalConfirm" sourceRef="Task_SaveTrip" targetRef="Event_FinalConfirm" />
    <messageFlow id="Flow_1wgoorp" sourceRef="Task_SendTripData" targetRef="Event_170v1zb" />
    <messageFlow id="Flow_1l274g6" sourceRef="Task_RejectObstacle" targetRef="Event_ReceiveDecision" />
    <textAnnotation id="TextAnnotation_0kt67ch">
      <text>Automatically recorded trip</text>
    </textAnnotation>
  </collaboration>
  <process id="Process_System" isExecutable="false">
    <startEvent id="Start_System">
      <outgoing>Flow_S1</outgoing>
    </startEvent>
    <task id="Task_SendTripData" name="Send trip details">
      <incoming>Flow_S1</incoming>
      <outgoing>Flow_S2</outgoing>
    </task>
    <task id="Task_PrepareObstacleList" name="Prepare obstacle list">
      <incoming>Flow_S2</incoming>
      <outgoing>Flow_S3</outgoing>
    </task>
    <task id="Task_SendObstacle" name="Send obstacle with position and type">
      <incoming>Flow_S3</incoming>
      <incoming>Flow_S_Loop</incoming>
      <outgoing>Flow_S4</outgoing>
    </task>
    <intermediateCatchEvent id="Event_ReceiveDecision">
      <incoming>Flow_S4</incoming>
      <outgoing>Flow_S5</outgoing>
      <messageEventDefinition id="MessageEventDefinition_1" />
    </intermediateCatchEvent>
    <exclusiveGateway id="Gateway_Confirmed">
      <incoming>Flow_S5</incoming>
      <outgoing>Flow_Confirmed</outgoing>
      <outgoing>Flow_Rejected</outgoing>
    </exclusiveGateway>
    <task id="Task_StoreObstacle" name="Store confirmed obstacle">
      <incoming>Flow_Confirmed</incoming>
      <outgoing>Flow_S6</outgoing>
    </task>
    <task id="Task_DiscardObstacle" name="Discard rejected obstacle">
      <incoming>Flow_Rejected</incoming>
      <outgoing>Flow_S7</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Merge1">
      <incoming>Flow_S6</incoming>
      <incoming>Flow_S7</incoming>
      <outgoing>Flow_S8</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_MoreObstacles">
      <incoming>Flow_S8</incoming>
      <outgoing>Flow_S_Loop</outgoing>
      <outgoing>Flow_S9</outgoing>
    </exclusiveGateway>
    <task id="Task_SaveTrip" name="Save trip with confirmed obstacles">
      <incoming>Flow_S9</incoming>
      <outgoing>Flow_S10</outgoing>
    </task>
    <endEvent id="End_System">
      <incoming>Flow_S10</incoming>
    </endEvent>
    <sequenceFlow id="Flow_S1" sourceRef="Start_System" targetRef="Task_SendTripData" />
    <sequenceFlow id="Flow_S2" sourceRef="Task_SendTripData" targetRef="Task_PrepareObstacleList" />
    <sequenceFlow id="Flow_S3" sourceRef="Task_PrepareObstacleList" targetRef="Task_SendObstacle" />
    <sequenceFlow id="Flow_S4" sourceRef="Task_SendObstacle" targetRef="Event_ReceiveDecision" />
    <sequenceFlow id="Flow_S5" sourceRef="Event_ReceiveDecision" targetRef="Gateway_Confirmed" />
    <sequenceFlow id="Flow_Confirmed" name="Confirmed" sourceRef="Gateway_Confirmed" targetRef="Task_StoreObstacle" />
    <sequenceFlow id="Flow_Rejected" name="Rejected" sourceRef="Gateway_Confirmed" targetRef="Task_DiscardObstacle" />
    <sequenceFlow id="Flow_S6" sourceRef="Task_StoreObstacle" targetRef="Gateway_Merge1" />
    <sequenceFlow id="Flow_S7" sourceRef="Task_DiscardObstacle" targetRef="Gateway_Merge1" />
    <sequenceFlow id="Flow_S8" sourceRef="Gateway_Merge1" targetRef="Gateway_MoreObstacles" />
    <sequenceFlow id="Flow_S_Loop" name="More obstacles" sourceRef="Gateway_MoreObstacles" targetRef="Task_SendObstacle" />
    <sequenceFlow id="Flow_S9" name="All reviewed" sourceRef="Gateway_MoreObstacles" targetRef="Task_SaveTrip" />
    <sequenceFlow id="Flow_S10" sourceRef="Task_SaveTrip" targetRef="End_System" />
  </process>
  <process id="Process_User" isExecutable="false">
    <task id="Task_ViewTrip" name="View trip details">
      <incoming>Flow_0m8bj8y</incoming>
      <outgoing>Flow_U3</outgoing>
    </task>
    <intermediateCatchEvent id="Event_ReceiveObstacle">
      <incoming>Flow_U3</incoming>
      <incoming>Flow_U_Loop</incoming>
      <outgoing>Flow_U4</outgoing>
      <messageEventDefinition id="MessageEventDefinition_4" />
    </intermediateCatchEvent>
    <task id="Task_ReviewObstacle" name="Review obstacle position and type">
      <incoming>Flow_U4</incoming>
      <outgoing>Flow_U5</outgoing>
    </task>
    <exclusiveGateway id="Gateway_UserDecision">
      <incoming>Flow_U5</incoming>
      <outgoing>Flow_U_Confirm</outgoing>
      <outgoing>Flow_U_Reject</outgoing>
    </exclusiveGateway>
    <task id="Task_RejectObstacle" name="Reject obstacle">
      <incoming>Flow_U_Reject</incoming>
      <outgoing>Flow_U7</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Merge2">
      <incoming>Flow_U6</incoming>
      <incoming>Flow_U7</incoming>
      <outgoing>Flow_U8</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_Continue">
      <incoming>Flow_U8</incoming>
      <outgoing>Flow_U_Loop</outgoing>
      <outgoing>Flow_U9</outgoing>
    </exclusiveGateway>
    <intermediateCatchEvent id="Event_FinalConfirm">
      <incoming>Flow_U9</incoming>
      <outgoing>Flow_U10</outgoing>
      <messageEventDefinition id="MessageEventDefinition_5" />
    </intermediateCatchEvent>
    <endEvent id="End_User">
      <incoming>Flow_U10</incoming>
    </endEvent>
    <sequenceFlow id="Flow_U3" sourceRef="Task_ViewTrip" targetRef="Event_ReceiveObstacle" />
    <sequenceFlow id="Flow_U4" sourceRef="Event_ReceiveObstacle" targetRef="Task_ReviewObstacle" />
    <sequenceFlow id="Flow_U5" sourceRef="Task_ReviewObstacle" targetRef="Gateway_UserDecision" />
    <sequenceFlow id="Flow_U_Confirm" name="Confirm" sourceRef="Gateway_UserDecision" targetRef="Task_ConfirmObstacle" />
    <sequenceFlow id="Flow_U_Reject" name="Reject" sourceRef="Gateway_UserDecision" targetRef="Task_RejectObstacle" />
    <sequenceFlow id="Flow_U6" sourceRef="Task_ConfirmObstacle" targetRef="Gateway_Merge2" />
    <sequenceFlow id="Flow_U7" sourceRef="Task_RejectObstacle" targetRef="Gateway_Merge2" />
    <sequenceFlow id="Flow_U8" sourceRef="Gateway_Merge2" targetRef="Gateway_Continue" />
    <sequenceFlow id="Flow_U_Loop" name="Next obstacle" sourceRef="Gateway_Continue" targetRef="Event_ReceiveObstacle" />
    <sequenceFlow id="Flow_U9" name="Finish" sourceRef="Gateway_Continue" targetRef="Event_FinalConfirm" />
    <sequenceFlow id="Flow_U10" sourceRef="Event_FinalConfirm" targetRef="End_User" />
    <startEvent id="Event_170v1zb">
      <outgoing>Flow_0m8bj8y</outgoing>
      <messageEventDefinition id="MessageEventDefinition_13jbt2q" />
    </startEvent>
    <sequenceFlow id="Flow_0m8bj8y" sourceRef="Event_170v1zb" targetRef="Task_ViewTrip" />
    <task id="Task_ConfirmObstacle" name="Confirm obstacle">
      <incoming>Flow_U_Confirm</incoming>
      <outgoing>Flow_U6</outgoing>
    </task>
  </process>
