      <incoming>Flow_0j1ef3r</incoming>
      <outgoing>Flow_B13</outgoing>
    </task>
    <task id="Activity_1gi6h0t" name="Save as personal Trip in database">
      <incoming>Flow_1xg03j6</incoming>
      <outgoing>Flow_0i2xm5g</outgoing>
    </task>
