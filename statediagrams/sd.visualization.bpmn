<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_PathVisualization_V2_Final" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0">
  <bpmn:collaboration id="Collaboration_PathVisualization_V2" name="2. Path Visualization and Comparison">
    <bpmn:participant id="Participant_User" name="User" processRef="Process_UserVisualization" />
    <bpmn:participant id="Participant_BBPSystem" name="BBP System" processRef="Process_BBPSystem_Visualization" />
    <bpmn:participant id="Participant_MapService" name="Map Service (External)" processRef="Process_MapService" />
    <bpmn:messageFlow id="MessageFlow_RequestVisualization" sourceRef="Event_RequestMapVisualization" targetRef="Event_ReceiveVisualizationRequest" />
    <bpmn:messageFlow id="MessageFlow_MapRequest_BBP_Map" sourceRef="Event_RequestMapService" targetRef="Event_ReceiveMapRequest" />
    <bpmn:messageFlow id="MessageFlow_MapData" sourceRef="Event_SendMapData" targetRef="Event_ReceiveMapData" />
    <bpmn:messageFlow id="MessageFlow_SendVisualResponse" sourceRef="Event_SendVisualResponse" targetRef="Event_ReceiveVisualizedResults" />
    <bpmn:messageFlow id="MessageFlow_SendDetails" sourceRef="Event_SendDetails" targetRef="Event_ReceivePathDetails" />
    <bpmn:messageFlow id="Flow_0mpk4jj" sourceRef="Event_RequestPathDetails" targetRef="Event_ReceiveDetailRequest" />
  </bpmn:collaboration>
  <bpmn:process id="Process_UserVisualization" name="User Process: View and Compare Paths" isExecutable="true">
    <bpmn:startEvent id="StartEvent_WantsToVisualize" name="User starts viewing sorted paths data">
      <bpmn:documentation>Starts after receiving sorted data from Diagram 1.</bpmn:documentation>
      <bpmn:outgoing>Flow_ToRequestVisualization</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToRequestVisualization" sourceRef="StartEvent_WantsToVisualize" targetRef="Event_RequestMapVisualization" />
    <bpmn:intermediateThrowEvent id="Event_RequestMapVisualization" name="Request map visualization">
      <bpmn:incoming>Flow_ToRequestVisualization</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitingForMap</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_RequestMap" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_WaitingForMap" sourceRef="Event_RequestMapVisualization" targetRef="Event_ReceiveVisualizedResults" />
    <bpmn:sequenceFlow id="Flow_ToViewCompare" sourceRef="Event_ReceiveVisualizedResults" targetRef="Task_ViewComparePaths" />
    <bpmn:sequenceFlow id="Flow_ToCheckDetails" sourceRef="Task_ViewComparePaths" targetRef="Gateway_ViewDetails" />
    <bpmn:sequenceFlow id="Flow_ViewDetails" name="View Details" sourceRef="Gateway_ViewDetails" targetRef="Event_RequestPathDetails">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">#{wantsDetails == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_WaitForDetails" sourceRef="Event_RequestPathDetails" targetRef="Event_ReceivePathDetails" />
    <bpmn:sequenceFlow id="Flow_ToViewObstacles" sourceRef="Event_ReceivePathDetails" targetRef="Task_ViewObstacleDetails" />
    <bpmn:sequenceFlow id="Flow_DetailsViewed" sourceRef="Task_ViewObstacleDetails" targetRef="Gateway_ViewDetails" />
    <bpmn:sequenceFlow id="Flow_FinishVisualization" name="Finish" sourceRef="Gateway_ViewDetails" targetRef="EndEvent_VisualizationComplete" />
    <bpmn:intermediateCatchEvent id="Event_ReceiveVisualizedResults" name="Receive visualized paths (on map)">
      <bpmn:incoming>Flow_WaitingForMap</bpmn:incoming>
      <bpmn:outgoing>Flow_ToViewCompare</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_VisualizedResults" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ViewComparePaths" name="View scored paths on map and compare routes">
      <bpmn:incoming>Flow_ToViewCompare</bpmn:incoming>
      <bpmn:outgoing>Flow_ToCheckDetails</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ViewDetails" name="View Details or Finish?">
      <bpmn:incoming>Flow_ToCheckDetails</bpmn:incoming>
      <bpmn:incoming>Flow_DetailsViewed</bpmn:incoming>
      <bpmn:outgoing>Flow_ViewDetails</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinishVisualization</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_ReceivePathDetails" name="Receive path details (status, obstacles,...)">
      <bpmn:incoming>Flow_WaitForDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_ToViewObstacles</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_PathDetails" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_ViewObstacleDetails" name="View detailed information">
      <bpmn:incoming>Flow_ToViewObstacles</bpmn:incoming>
      <bpmn:outgoing>Flow_DetailsViewed</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Event_RequestPathDetails" name="Request details for selected path">
      <bpmn:incoming>Flow_ViewDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitForDetails</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_RequestDetails" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="EndEvent_VisualizationComplete" name="Visualization session completed">
      <bpmn:incoming>Flow_FinishVisualization</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_BBPSystem_Visualization" name="BBP System Process: Map Preparation and Data Retrieval" isExecutable="true">
    <bpmn:startEvent id="Event_ReceiveVisualizationRequest" name="Receive request for map visualization">
      <bpmn:outgoing>Flow_ToMapServiceRequest</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_RequestMap" />
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="Event_RequestMapService" name="Request Map Service for rendering">
      <bpmn:incoming>Flow_ToMapServiceRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitingForMapData</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_MapDataRequest" />
    </bpmn:intermediateThrowEvent>
    <bpmn:sequenceFlow id="Flow_ToMapServiceRequest" sourceRef="Event_ReceiveVisualizationRequest" targetRef="Event_RequestMapService" />
    <bpmn:sequenceFlow id="Flow_WaitingForMapData" sourceRef="Event_RequestMapService" targetRef="Event_ReceiveMapData" />
    <bpmn:sequenceFlow id="Flow_ToRetrieveDetails" sourceRef="Event_ReceiveDetailRequest" targetRef="Task_RetrievePathDetails" />
    <bpmn:sequenceFlow id="Flow_ToSendDetails" sourceRef="Task_RetrievePathDetails" targetRef="Event_SendDetails" />
    <bpmn:intermediateCatchEvent id="Event_ReceiveMapData">
      <bpmn:incoming>Flow_WaitingForMapData</bpmn:incoming>
      <bpmn:outgoing>Flow_0w9upmt</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_MapData" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_0w9upmt" sourceRef="Event_ReceiveMapData" targetRef="Activity_00l02r2" />
    <bpmn:intermediateThrowEvent id="Event_SendVisualResponse" name="Send final result">
      <bpmn:incoming>Flow_1skhbc5</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_VisualizedResults" />
    </bpmn:intermediateThrowEvent>
    <bpmn:startEvent id="Event_ReceiveDetailRequest" name="Receive request for specific path details">
      <bpmn:outgoing>Flow_ToRetrieveDetails</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_RequestDetails" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_RetrievePathDetails" name="Retrieve detailed path info (status, obstacles)">
      <bpmn:incoming>Flow_ToRetrieveDetails</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendDetails</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_SendDetails" name="Send detailed info to user">
      <bpmn:incoming>Flow_ToSendDetails</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_PathDetails" />
    </bpmn:endEvent>
    <bpmn:serviceTask id="Activity_00l02r2" name="Prepare visual response (Data + Map Overlay)">
      <bpmn:incoming>Flow_0w9upmt</bpmn:incoming>
      <bpmn:outgoing>Flow_1skhbc5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1skhbc5" sourceRef="Activity_00l02r2" targetRef="Event_SendVisualResponse" />
  </bpmn:process>
  <bpmn:process id="Process_MapService" name="Map Service Process" isExecutable="false">
    <bpmn:startEvent id="Event_ReceiveMapRequest" name="Receive visualization request">
      <bpmn:outgoing>Flow_ToGenerateMap</bpmn:outgoing>
      <bpmn:messageEventDefinition messageRef="Message_MapDataRequest" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_ToGenerateMap" sourceRef="Event_ReceiveMapRequest" targetRef="Task_GenerateMapVisualization" />
    <bpmn:serviceTask id="Task_GenerateMapVisualization" name="Generate map with bike paths overlay">
      <bpmn:documentation>External map service renders paths and highlights scores.</bpmn:documentation>
      <bpmn:incoming>Flow_ToGenerateMap</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSendMap</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToSendMap" sourceRef="Task_GenerateMapVisualization" targetRef="Event_SendMapData" />
    <bpmn:endEvent id="Event_SendMapData" name="Send rendered map data to BBP System">
      <bpmn:incoming>Flow_ToSendMap</bpmn:incoming>
      <bpmn:messageEventDefinition messageRef="Message_MapData" />
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="Message_RequestMap" name="RequestMapVisualization" />
  <bpmn:message id="Message_MapDataRequest" name="MapDataRequest" />
  <bpmn:message id="Message_MapData" name="MapData" />
  <bpmn:message id="Message_VisualizedResults" name="VisualizedResults" />
  <bpmn:message id="Message_RequestDetails" name="RequestDetails" />
  <bpmn:message id="Message_PathDetails" name="PathDetails" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_PathVisualization_V2">
    <bpmndi:BPMNPlane id="BPMNPlane_PathVisualization_V2" bpmnElement="Collaboration_PathVisualization_V2">
