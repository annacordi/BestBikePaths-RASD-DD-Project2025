<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0">
  <collaboration id="Collaboration_ManualPathInsertion">
    <participant id="Participant_RegisteredUser" name="Registered User" processRef="Process_RegisteredUser" />
    <participant id="Participant_BBPSystem" name="BBP System" processRef="Process_BBPSystem" />
    <messageFlow id="MessageFlow_PathData" sourceRef="Task_SubmitPathData" targetRef="Event_ReceivePathData" />
    <messageFlow id="MessageFlow_ValidationResult" sourceRef="Task_ValidatePathData" targetRef="Event_ReceiveValidation" />
    <messageFlow id="MessageFlow_Confirmation" sourceRef="Task_SendConfirmation" targetRef="Event_ReceiveConfirmation" />
    <messageFlow id="Flow_1uuphcr" sourceRef="Event_SendDiscardRequest" targetRef="Event_ReceiveDiscardRequest" />
    <messageFlow id="Flow_0urhx8p" sourceRef="Event_SendSaveAndPublishRequest" targetRef="Event_ReceiveSaveAndPublishRequest" />
    <messageFlow id="Flow_12wajxd" sourceRef="Event_SendPublishRequest" targetRef="Event_ReceivePublishRequest" />
    <messageFlow id="Flow_0r1xoez" sourceRef="Event_SendSaveRequest" targetRef="Event_ReceiveSaveRequest" />
    <messageFlow id="Flow_12cp517" sourceRef="Event_SendSuccess" targetRef="Event_01k9vd1" />
  </collaboration>
  <process id="Process_RegisteredUser" name="Registered User Process" isExecutable="false">
    <sequenceFlow id="Flow_ValidationFail_Retry" sourceRef="Gateway_RetryOrCancel" targetRef="Task_SelectPathRoute" />
    <startEvent id="StartEvent_RU" name="RU want to manual insert path">
      <outgoing>Flow_Start_Task1</outgoing>
    </startEvent>
    <task id="Task_SelectPathRoute" name="Insert origin and destination">
      <incoming>Flow_Start_Task1</incoming>
      <incoming>Flow_ValidationFail_Retry</incoming>
      <outgoing>Flow_Task1_Task2</outgoing>
    </task>
    <task id="Task_AddPathDetails" name="Add path details: difficulty, surface type">
      <incoming>Flow_0lqf5ia</incoming>
      <outgoing>Flow_Task2_Gateway1</outgoing>
    </task>
    <task id="Activity_1c37fw7" name="Select path route on map">
      <incoming>Flow_Task1_Task2</incoming>
      <outgoing>Flow_0lqf5ia</outgoing>
    </task>
    <exclusiveGateway id="Gateway_ReportObstacles" name="Report obstacles?">
      <incoming>Flow_Task2_Gateway1</incoming>
      <outgoing>Flow_Gateway1_Yes</outgoing>
      <outgoing>Flow_Gateway1_No</outgoing>
    </exclusiveGateway>
    <task id="Task_ReportObstacles" name="Report obstacles (type, address)">
      <incoming>Flow_Gateway1_Yes</incoming>
      <outgoing>Flow_111ac29</outgoing>
    </task>
    <exclusiveGateway id="Gateway_ValidationCheck" name="Path valid?">
      <incoming>Flow_Wait1_Gateway2</incoming>
      <outgoing>Flow_1wfb5n5</outgoing>
      <outgoing>Flow_0c2jfp5</outgoing>
    </exclusiveGateway>
    <task id="Task_SubmitPathData" name="Submit path data">
      <incoming>Flow_Merge1_Task3</incoming>
      <outgoing>Flow_Task3_Wait1</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Merge1" name="">
      <incoming>Flow_Gateway1_No</incoming>
      <incoming>Flow_111ac29</incoming>
      <outgoing>Flow_Merge1_Task3</outgoing>
    </exclusiveGateway>
    <intermediateCatchEvent id="Event_ReceiveValidation" name="Receive validation result">
      <incoming>Flow_Task3_Wait1</incoming>
      <outgoing>Flow_Wait1_Gateway2</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <task id="Task_ReviewErrors" name="Review validation errors">
      <incoming>Flow_1wfb5n5</incoming>
      <outgoing>Flow_Errors_Gateway3</outgoing>
    </task>
    <intermediateCatchEvent id="Event_ReceiveConfirmation" name="Receive confirmation">
      <incoming>Flow_0c2jfp5</incoming>
      <outgoing>Flow_0hrowgt</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <task id="Activity_0mf99ju" name="Path inserted successfully">
      <incoming>Flow_0hrowgt</incoming>
      <outgoing>Flow_0in3da7</outgoing>
    </task>
    <exclusiveGateway id="Gateway_RetryOrCancel" name="Retry or cancel?">
      <incoming>Flow_Errors_Gateway3</incoming>
      <outgoing>Flow_Gateway3_Retry</outgoing>
      <outgoing>Flow_Gateway3_Cancel</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_Decision" name="Action?">
      <incoming>Flow_0in3da7</incoming>
      <outgoing>Flow_SaveOnly</outgoing>
      <outgoing>Flow_PublishOnly</outgoing>
      <outgoing>Flow_SaveAndPublish</outgoing>
      <outgoing>Flow_Discard</outgoing>
    </exclusiveGateway>
    <intermediateThrowEvent id="Event_SendDiscardRequest" name="Send discard request">
      <incoming>Flow_Discard</incoming>
      <outgoing>Flow_0wkf3nt</outgoing>
      <messageEventDefinition id="MessageEventDefinition_16brqyb" />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="Event_SendSaveRequest" name="Send save request">
      <incoming>Flow_SaveOnly</incoming>
      <outgoing>Flow_1y2i2sf</outgoing>
      <messageEventDefinition id="MessageEventDefinition_1od4vu9" />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="Event_SendPublishRequest" name="Send publish request">
      <incoming>Flow_PublishOnly</incoming>
      <outgoing>Flow_0s6ah2f</outgoing>
      <messageEventDefinition id="MessageEventDefinition_0l3yf2q" />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="Event_SendSaveAndPublishRequest" name="Send request">
      <incoming>Flow_SaveAndPublish</incoming>
      <outgoing>Flow_1iev8sw</outgoing>
      <messageEventDefinition id="MessageEventDefinition_1i2dbu5" />
    </intermediateThrowEvent>
    <intermediateCatchEvent id="Event_01k9vd1" name="Receive success confirmation">
      <incoming>Flow_1bftm0l</incoming>
      <outgoing>Flow_0c7eemt</outgoing>
      <messageEventDefinition id="MessageEventDefinition_0kcrfgt" />
    </intermediateCatchEvent>
    <endEvent id="Event_0uy0scy" name="End session">
      <incoming>Flow_0c7eemt</incoming>
    </endEvent>
    <exclusiveGateway id="Gateway_0zyb6qi" name="">
      <incoming>Flow_0wkf3nt</incoming>
      <incoming>Flow_1y2i2sf</incoming>
      <incoming>Flow_0s6ah2f</incoming>
      <incoming>Flow_1iev8sw</incoming>
      <outgoing>Flow_1bftm0l</outgoing>
    </exclusiveGateway>
    <endEvent id="EndEvent_Cancelled" name="Insertion cancelled">
      <incoming>Flow_Gateway3_Cancel</incoming>
    </endEvent>
    <sequenceFlow id="Flow_Start_Task1" sourceRef="StartEvent_RU" targetRef="Task_SelectPathRoute" />
    <sequenceFlow id="Flow_Gateway3_Retry" name="Retry" sourceRef="Gateway_RetryOrCancel" targetRef="Task_SelectPathRoute" />
    <sequenceFlow id="Flow_Task1_Task2" sourceRef="Task_SelectPathRoute" targetRef="Activity_1c37fw7" />
    <sequenceFlow id="Flow_0lqf5ia" sourceRef="Activity_1c37fw7" targetRef="Task_AddPathDetails" />
    <sequenceFlow id="Flow_Task2_Gateway1" sourceRef="Task_AddPathDetails" targetRef="Gateway_ReportObstacles" />
    <sequenceFlow id="Flow_Gateway1_Yes" name="Yes" sourceRef="Gateway_ReportObstacles" targetRef="Task_ReportObstacles" />
    <sequenceFlow id="Flow_Gateway1_No" name="No" sourceRef="Gateway_ReportObstacles" targetRef="Gateway_Merge1" />
    <sequenceFlow id="Flow_111ac29" sourceRef="Task_ReportObstacles" targetRef="Gateway_Merge1" />
    <sequenceFlow id="Flow_Wait1_Gateway2" sourceRef="Event_ReceiveValidation" targetRef="Gateway_ValidationCheck" />
    <sequenceFlow id="Flow_1wfb5n5" name="Invalid" sourceRef="Gateway_ValidationCheck" targetRef="Task_ReviewErrors" />
    <sequenceFlow id="Flow_0c2jfp5" name="Valid" sourceRef="Gateway_ValidationCheck" targetRef="Event_ReceiveConfirmation" />
    <sequenceFlow id="Flow_Merge1_Task3" sourceRef="Gateway_Merge1" targetRef="Task_SubmitPathData" />
    <sequenceFlow id="Flow_Task3_Wait1" sourceRef="Task_SubmitPathData" targetRef="Event_ReceiveValidation" />
    <sequenceFlow id="Flow_Errors_Gateway3" sourceRef="Task_ReviewErrors" targetRef="Gateway_RetryOrCancel" />
    <sequenceFlow id="Flow_0hrowgt" sourceRef="Event_ReceiveConfirmation" targetRef="Activity_0mf99ju" />
    <sequenceFlow id="Flow_0in3da7" sourceRef="Activity_0mf99ju" targetRef="Gateway_Decision" />
    <sequenceFlow id="Flow_Gateway3_Cancel" name="Cancel" sourceRef="Gateway_RetryOrCancel" targetRef="EndEvent_Cancelled" />
    <sequenceFlow id="Flow_SaveOnly" name="Save as Trip only" sourceRef="Gateway_Decision" targetRef="Event_SendSaveRequest">
      <conditionExpression xsi:type="tFormalExpression">#{decision == 'saveOnly'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_PublishOnly" name="Publish as BikePath only" sourceRef="Gateway_Decision" targetRef="Event_SendPublishRequest">
      <conditionExpression xsi:type="tFormalExpression">#{decision == 'publishOnly'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_SaveAndPublish" name="Save &#38; Publish" sourceRef="Gateway_Decision" targetRef="Event_SendSaveAndPublishRequest">
      <conditionExpression xsi:type="tFormalExpression">#{decision == 'saveAndPublish'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Discard" name="Discard" sourceRef="Gateway_Decision" targetRef="Event_SendDiscardRequest">
      <conditionExpression xsi:type="tFormalExpression">#{decision == 'discard'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_0wkf3nt" sourceRef="Event_SendDiscardRequest" targetRef="Gateway_0zyb6qi" />
    <sequenceFlow id="Flow_1y2i2sf" sourceRef="Event_SendSaveRequest" targetRef="Gateway_0zyb6qi" />
    <sequenceFlow id="Flow_0s6ah2f" sourceRef="Event_SendPublishRequest" targetRef="Gateway_0zyb6qi" />
    <sequenceFlow id="Flow_1iev8sw" sourceRef="Event_SendSaveAndPublishRequest" targetRef="Gateway_0zyb6qi" />
    <sequenceFlow id="Flow_1bftm0l" sourceRef="Gateway_0zyb6qi" targetRef="Event_01k9vd1" />
    <sequenceFlow id="Flow_0c7eemt" sourceRef="Event_01k9vd1" targetRef="Event_0uy0scy" />
  </process>
  <process id="Process_BBPSystem" name="BBP System Process" isExecutable="false">
    <intermediateCatchEvent id="Event_ReceivePathData" name="Receive path data">
      <outgoing>Flow_Start_Validate</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <task id="Task_ValidatePathData" name="Validate path data (completeness, format, coordinates)">
      <incoming>Flow_Start_Validate</incoming>
      <outgoing>Flow_Validate_Gateway1</outgoing>
    </task>
    <exclusiveGateway id="Gateway_IsValid" name="Data valid?">
      <incoming>Flow_Validate_Gateway1</incoming>
      <outgoing>Flow_Gateway1_Invalid</outgoing>
      <outgoing>Flow_Gateway1_Valid</outgoing>
    </exclusiveGateway>
    <task id="Task_SendValidationResult" name="Send validation errors">
      <incoming>Flow_Gateway1_Invalid</incoming>
      <outgoing>Flow_Invalid_End</outgoing>
    </task>
    <endEvent id="EndEvent_ValidationFailed" name="Validation failed">
      <incoming>Flow_Invalid_End</incoming>
    </endEvent>
    <task id="Task_CalculatePathMetrics" name="Calculate path metrics (distance, elevation)">
      <incoming>Flow_Gateway1_Valid</incoming>
      <outgoing>Flow_Calc_Gateway2</outgoing>
    </task>
    <exclusiveGateway id="Gateway_HasObstacles" name="Obstacles reported?">
      <incoming>Flow_Calc_Gateway2</incoming>
      <outgoing>Flow_Gateway2_Yes</outgoing>
      <outgoing>Flow_Gateway2_No</outgoing>
    </exclusiveGateway>
    <task id="Task_ProcessObstacles" name="Process and store obstacle information">
      <incoming>Flow_Gateway2_Yes</incoming>
      <outgoing>Flow_Obstacles_Merge2</outgoing>
    </task>
    <task id="Task_UpdateSearchIndex" name="Update search index (make path discoverable)">
      <incoming>Flow_Save_Index</incoming>
      <outgoing>Flow_Index_Confirm</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Merge2" name="">
      <incoming>Flow_Gateway2_No</incoming>
      <incoming>Flow_Obstacles_Merge2</incoming>
      <outgoing>Flow_Merge2_Save</outgoing>
    </exclusiveGateway>
    <task id="Task_SavePathToDatabase" name="Save path in database">
      <incoming>Flow_Merge2_Save</incoming>
      <outgoing>Flow_Save_Index</outgoing>
    </task>
    <task id="Task_SendConfirmation" name="Send success confirmation">
      <incoming>Flow_Index_Confirm</incoming>
      <outgoing>Flow_0109vgq</outgoing>
    </task>
    <intermediateCatchEvent id="Event_ReceiveDiscardRequest" name="Receive discard request">
      <incoming>Flow_0j2x0o9</incoming>
      <outgoing>Flow_B22</outgoing>
      <messageEventDefinition id="MessageEventDefinition_0zmbq9o" />
    </intermediateCatchEvent>
    <task id="Task_DeleteData" name="Delete data">
      <incoming>Flow_B22</incoming>
      <outgoing>Flow_1o1pdc3</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Merge" name="">
      <incoming>Flow_1o1pdc3</incoming>
      <incoming>Flow_B14</incoming>
      <incoming>Flow_1u437nb</incoming>
      <outgoing>Flow_B24</outgoing>
    </exclusiveGateway>
    <intermediateCatchEvent id="Event_ReceiveSaveRequest" name="Receive save request">
      <incoming>Flow_1y304q6</incoming>
      <outgoing>Flow_0eo2w5e</outgoing>
      <messageEventDefinition id="MessageEventDefinition_0no6vft" />
    </intermediateCatchEvent>
    <task id="Task_FetchWeatherData" name="Fetch weather data from external service (if available)">
      <incoming>Flow_0eo2w5e</incoming>
      <outgoing>Flow_1x41gr1</outgoing>
    </task>
    <task id="Task_SavePersonalTrip" name="Save as personal Trip in database">
      <incoming>Flow_1x41gr1</incoming>
      <outgoing>Flow_1u437nb</outgoing>
    </task>
    <eventBasedGateway id="Gateway_0cck0sv" name="">
      <incoming>Flow_0109vgq</incoming>
      <outgoing>Flow_1y304q6</outgoing>
      <outgoing>Flow_1s9qotw</outgoing>
      <outgoing>Flow_1bk776b</outgoing>
      <outgoing>Flow_0j2x0o9</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="Event_ReceiveSaveAndPublishRequest" name="Receive save&#38;publish request">
      <incoming>Flow_1bk776b</incoming>
      <outgoing>Flow_0voqfcg</outgoing>
      <messageEventDefinition id="MessageEventDefinition_0586mw3" />
    </intermediateCatchEvent>
    <task id="Activity_1oq88y0" name="Fetch weather data from external service (if available)">
      <incoming>Flow_0voqfcg</incoming>
      <outgoing>Flow_0elhn1g</outgoing>
    </task>
