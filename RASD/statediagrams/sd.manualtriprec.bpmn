  <collaboration id="Collaboration_TripRecording">
    <participant id="Participant_RegisteredUser" name="Registered User" processRef="Process_RegisteredUser" />
    <participant id="Participant_BBPSystem" name="BBP System" processRef="Process_BBPSystem" />
    <messageFlow id="MessageFlow_StopTrip" sourceRef="Task_StopRecording" targetRef="Event_ReceiveStopTrip" />
    <messageFlow id="MessageFlow_SaveRequest" sourceRef="Task_SubmitTripData" targetRef="Event_ReceiveSaveRequest" />
    <messageFlow id="MessageFlow_TripSaved" sourceRef="Task_ReturnSuccess" targetRef="Event_ReceiveTripSaved" />
    <messageFlow id="Flow_0b0v7v0" sourceRef="Activity_0e3niro" targetRef="Event_1bt0kwn" />
    <messageFlow id="Flow_06r0frd" sourceRef="Task_StartRecording" targetRef="Event_1ak4mig" />
    <messageFlow id="Flow_1od1bcu" sourceRef="Activity_0hvqty2" targetRef="Event_0slvkml" />
    <messageFlow id="Flow_1j673oo" sourceRef="Activity_0ki5d2q" targetRef="Event_1djzamm" />
    <textAnnotation id="TextAnnotation_1ex9pqe">
      <text>Receive storing request</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_0g65b0n">
      <text>save and publish</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_07uc0z6">
      <text>Don't save and publish</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_0rte56w">
      <text>Deletion request</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_0rqx11o">
      <text>Path deleted</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_03hs36y">
      <text>Confirmation of deletion</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_0tb6rd4">
      <text>Path deleted</text>
    </textAnnotation>
  </collaboration>
  <process id="Process_RegisteredUser" name="Registered User Process" isExecutable="false">
    <startEvent id="StartEvent_RU" name="Want to record trip">
      <outgoing>Flow_Start_Task1</outgoing>
    </startEvent>
    <task id="Task_StartRecording" name="Start trip recording">
      <incoming>Flow_Start_Task1</incoming>
      <outgoing>Flow_Task1_Task2</outgoing>
    </task>
    <task id="Task_BikeTrip" name="Bike trip (GPS and sensor data collected)">
      <incoming>Flow_Task1_Task2</incoming>
      <outgoing>Flow_Task2_Task3</outgoing>
    </task>
    <task id="Task_StopRecording" name="Stop trip recording">
      <incoming>Flow_Task2_Task3</incoming>
      <outgoing>Flow_Task3_Gateway1</outgoing>
    </task>
    <exclusiveGateway id="Gateway_SaveOrPublish" name="Save and publish?">
      <incoming>Flow_Task3_Gateway1</incoming>
      <outgoing>Flow_Gateway1_Publish</outgoing>
      <outgoing>Flow_1uq7eds</outgoing>
      <outgoing>Flow_0vv8ty5</outgoing>
    </exclusiveGateway>
    <intermediateCatchEvent id="Event_ReceiveTripSaved" name="Receive confirmation">
      <incoming>Flow_Task4_Wait</incoming>
      <incoming>Flow_1fkmkvw</incoming>
      <outgoing>Flow_Wait_End</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <endEvent id="EndEvent_RU" name="Trip saved">
      <incoming>Flow_Wait_End</incoming>
    </endEvent>
    <sequenceFlow id="Flow_Start_Task1" sourceRef="StartEvent_RU" targetRef="Task_StartRecording" />
    <sequenceFlow id="Flow_Task1_Task2" sourceRef="Task_StartRecording" targetRef="Task_BikeTrip" />
    <sequenceFlow id="Flow_Task2_Task3" sourceRef="Task_BikeTrip" targetRef="Task_StopRecording" />
    <sequenceFlow id="Flow_Task3_Gateway1" sourceRef="Task_StopRecording" targetRef="Gateway_SaveOrPublish" />
    <sequenceFlow id="Flow_Gateway1_Publish" name="Only save" sourceRef="Gateway_SaveOrPublish" targetRef="Task_SubmitTripData" />
    <sequenceFlow id="Flow_Task4_Wait" sourceRef="Task_SubmitTripData" targetRef="Event_ReceiveTripSaved" />
    <sequenceFlow id="Flow_Wait_End" sourceRef="Event_ReceiveTripSaved" targetRef="EndEvent_RU" />
    <task id="Activity_0e3niro" name="Save data in MyTrips">
      <incoming>Flow_1uq7eds</incoming>
      <outgoing>Flow_1fkmkvw</outgoing>
    </task>
    <sequenceFlow id="Flow_1uq7eds" sourceRef="Gateway_SaveOrPublish" targetRef="Activity_0e3niro" />
    <sequenceFlow id="Flow_1fkmkvw" sourceRef="Activity_0e3niro" targetRef="Event_ReceiveTripSaved" />
    <task id="Task_SubmitTripData" name="Submit trip data to be published">
      <incoming>Flow_Gateway1_Publish</incoming>
      <outgoing>Flow_Task4_Wait</outgoing>
    </task>
    <sequenceFlow id="Flow_0vv8ty5" sourceRef="Gateway_SaveOrPublish" targetRef="Activity_0hvqty2" />
    <task id="Activity_0hvqty2" name="Don&#39;t save">
      <incoming>Flow_0vv8ty5</incoming>
      <outgoing>Flow_1lthuj8</outgoing>
    </task>
    <sequenceFlow id="Flow_0kemoy1" sourceRef="Event_1djzamm" targetRef="Event_06pwy75" />
    <sequenceFlow id="Flow_1lthuj8" sourceRef="Activity_0hvqty2" targetRef="Event_1djzamm" />
    <intermediateCatchEvent id="Event_1djzamm">
      <incoming>Flow_1lthuj8</incoming>
      <outgoing>Flow_0kemoy1</outgoing>
      <messageEventDefinition id="MessageEventDefinition_1t6swii" />
    </intermediateCatchEvent>
    <endEvent id="Event_06pwy75">
      <incoming>Flow_0kemoy1</incoming>
    </endEvent>
  </process>
  <process id="Process_BBPSystem" name="BBP System Process" isExecutable="false">
    <intermediateCatchEvent id="Event_ReceiveStopTrip" name="Receive stop request">
      <incoming>Flow_Sensor_Wait</incoming>
      <outgoing>Flow_Stop_Process</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <task id="Task_ProcessTripData" name="Process trip data: calculate distance, speed, metrics">
      <incoming>Flow_Stop_Process</incoming>
      <outgoing>Flow_Process_Weather</outgoing>
    </task>
    <task id="Task_FetchWeatherData" name="Fetch weather data from external service (if available)">
      <incoming>Flow_Process_Weather</incoming>
      <outgoing>Flow_Weather_Wait</outgoing>
    </task>
    <task id="Task_SavePersonalTrip" name="Save as personal Trip in database">
      <incoming>Flow_0frk7og</incoming>
      <outgoing>Flow_Personal_Merge</outgoing>
    </task>
    <task id="Task_PublishBikePath" name="Publish as BikePath (make available to community)">
      <incoming>Flow_0vkysto</incoming>
      <outgoing>Flow_Publish_Merge</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Merge" name="">
      <incoming>Flow_Personal_Merge</incoming>
      <incoming>Flow_Publish_Merge</incoming>
      <outgoing>Flow_Merge_Success</outgoing>
    </exclusiveGateway>
    <task id="Task_ReturnSuccess" name="Return success confirmation">
      <incoming>Flow_Merge_Success</incoming>
      <outgoing>Flow_Success_End</outgoing>
    </task>
    <endEvent id="EndEvent_BBP" name="Trip recorded">
      <incoming>Flow_Success_End</incoming>
    </endEvent>
    <sequenceFlow id="Flow_GPS_Sensor" sourceRef="Task_CollectGPSData" targetRef="Task_CollectSensorData" />
    <sequenceFlow id="Flow_Sensor_Wait" sourceRef="Task_CollectSensorData" targetRef="Event_ReceiveStopTrip" />
    <sequenceFlow id="Flow_Stop_Process" sourceRef="Event_ReceiveStopTrip" targetRef="Task_ProcessTripData" />
    <sequenceFlow id="Flow_Process_Weather" sourceRef="Task_ProcessTripData" targetRef="Task_FetchWeatherData" />
    <sequenceFlow id="Flow_Weather_Wait" sourceRef="Task_FetchWeatherData" targetRef="Event_ReceiveSaveRequest" />
    <sequenceFlow id="Flow_Personal_Merge" sourceRef="Task_SavePersonalTrip" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_Publish_Merge" sourceRef="Task_PublishBikePath" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_Merge_Success" sourceRef="Gateway_Merge" targetRef="Task_ReturnSuccess" />
    <sequenceFlow id="Flow_Success_End" sourceRef="Task_ReturnSuccess" targetRef="EndEvent_BBP" />
    <sequenceFlow id="Flow_0vkysto" sourceRef="Event_ReceiveSaveRequest" targetRef="Task_PublishBikePath" />
    <intermediateCatchEvent id="Event_1bt0kwn">
      <outgoing>Flow_0frk7og</outgoing>
      <messageEventDefinition id="MessageEventDefinition_13xd5s4" />
    </intermediateCatchEvent>
    <sequenceFlow id="Flow_0frk7og" sourceRef="Event_1bt0kwn" targetRef="Task_SavePersonalTrip" />
    <task id="Task_CollectGPSData" name="Start collecting GPS data">
      <incoming>Flow_1z063bt</incoming>
      <outgoing>Flow_GPS_Sensor</outgoing>
    </task>
    <task id="Task_CollectSensorData" name="Collect sensor data (accelerometer, gyroscope)">
      <incoming>Flow_GPS_Sensor</incoming>
      <outgoing>Flow_Sensor_Wait</outgoing>
    </task>
    <intermediateCatchEvent id="Event_ReceiveSaveRequest" name="Receive publish request">
      <incoming>Flow_Weather_Wait</incoming>
      <outgoing>Flow_0vkysto</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <startEvent id="Event_1ak4mig">
      <outgoing>Flow_1z063bt</outgoing>
      <messageEventDefinition id="MessageEventDefinition_0m4r3gl" />
    </startEvent>
    <sequenceFlow id="Flow_1z063bt" sourceRef="Event_1ak4mig" targetRef="Task_CollectGPSData" />
    <intermediateCatchEvent id="Event_0slvkml">
      <outgoing>Flow_10v8h7y</outgoing>
      <messageEventDefinition id="MessageEventDefinition_045l3r0" />
    </intermediateCatchEvent>
    <sequenceFlow id="Flow_10v8h7y" sourceRef="Event_0slvkml" targetRef="Activity_0ki5d2q" />
    <sequenceFlow id="Flow_02tgjhi" sourceRef="Activity_0ki5d2q" targetRef="Event_0am2qnc" />
    <endEvent id="Event_0am2qnc">
      <incoming>Flow_02tgjhi</incoming>
    </endEvent>
    <task id="Activity_0ki5d2q" name="Path deleted">
      <incoming>Flow_10v8h7y</incoming>
      <outgoing>Flow_02tgjhi</outgoing>
    </task>
  </process>
