<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_Weather" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.6.1">
  <collaboration id="Collab_Weather">
    <participant id="System" name="BBP System" processRef="Process_System" />
    <participant id="User" name="Registered User" processRef="Process_User" />
    <participant id="WeatherService" name="External Weather Service" processRef="Process_WeatherService" />
    <messageFlow id="Flow_TripData" sourceRef="Activity_SendTripData" targetRef="Event_ReceiveTripData" />
    <messageFlow id="Flow_WeatherRequest" sourceRef="Activity_RequestWeather" targetRef="Event_ReceiveWeatherRequest" />
    <messageFlow id="Flow_WeatherResponse" sourceRef="Activity_ProvideWeather" targetRef="Event_ReceiveWeatherData" />
    <messageFlow id="Flow_EnrichmentConfirm" sourceRef="Activity_ConfirmEnrichment" targetRef="Event_ReceiveConfirm" />
    <textAnnotation id="TextAnnotation_1">
      <text>User initiates trip recording</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_2">
      <text>Trip data sent to system</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_3">
      <text>Weather data available?</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_4">
      <text>Yes - Enrich with weather</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_5">
      <text>No - Store without weather</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_6">
      <text>Weather service responds</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_7">
      <text>Trip enriched and stored</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_0ii89gv">
      <text>Trip enriched with weather data?</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_1gazh4x">
      <text>No</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_05mlubk">
      <text>Yes</text>
    </textAnnotation>
    <textAnnotation id="TextAnnotation_04jqs7c">
      <text>RU want to see one of his trips</text>
    </textAnnotation>
  </collaboration>
  <process id="Process_User" isExecutable="false">
    <startEvent id="Event_Start">
      <outgoing>Flow_1</outgoing>
    </startEvent>
    <task id="Activity_RecordTrip" name="Record Trip (Manual or Auto)">
      <incoming>Flow_1</incoming>
      <outgoing>Flow_2</outgoing>
    </task>
    <task id="Activity_SendTripData" name="Send Trip Data">
      <incoming>Flow_2</incoming>
      <outgoing>Flow_3</outgoing>
    </task>
    <intermediateCatchEvent id="Event_ReceiveConfirm">
      <incoming>Flow_3</incoming>
      <outgoing>Flow_4</outgoing>
      <messageEventDefinition id="MessageEventDefinition_1" />
    </intermediateCatchEvent>
    <task id="Activity_ViewEnrichedTrip" name="View Trip">
      <incoming>Flow_4</incoming>
      <outgoing>Flow_5</outgoing>
    </task>
    <endEvent id="Event_End">
      <incoming>Flow_5</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1" sourceRef="Event_Start" targetRef="Activity_RecordTrip" />
    <sequenceFlow id="Flow_2" sourceRef="Activity_RecordTrip" targetRef="Activity_SendTripData" />
    <sequenceFlow id="Flow_3" sourceRef="Activity_SendTripData" targetRef="Event_ReceiveConfirm" />
    <sequenceFlow id="Flow_4" sourceRef="Event_ReceiveConfirm" targetRef="Activity_ViewEnrichedTrip" />
    <sequenceFlow id="Flow_5" sourceRef="Activity_ViewEnrichedTrip" targetRef="Event_End" />
  </process>
  <process id="Process_System" isExecutable="false">
    <intermediateCatchEvent id="Event_ReceiveTripData">
      <outgoing>Flow_S1</outgoing>
      <messageEventDefinition id="MessageEventDefinition_2" />
    </intermediateCatchEvent>
    <task id="Activity_ValidateTrip" name="Validate Trip Data">
      <incoming>Flow_S1</incoming>
      <outgoing>Flow_S2</outgoing>
    </task>
    <endEvent id="Event_SystemEnd">
      <incoming>Flow_S10</incoming>
    </endEvent>
    <task id="Activity_ConfirmEnrichment" name="Send Trip">
      <incoming>Flow_S9</incoming>
      <outgoing>Flow_S10</outgoing>
    </task>
    <exclusiveGateway id="Gateway_Merge">
      <incoming>Flow_S7</incoming>
      <incoming>Flow_S8</incoming>
      <outgoing>Flow_S9</outgoing>
    </exclusiveGateway>
    <task id="Activity_RequestWeather" name="Request Weather Data">
      <incoming>Flow_S2</incoming>
      <outgoing>Flow_S4</outgoing>
    </task>
    <intermediateCatchEvent id="Event_ReceiveWeatherData">
      <incoming>Flow_S4</incoming>
      <outgoing>Flow_1hwf1uf</outgoing>
      <messageEventDefinition id="MessageEventDefinition_3" />
    </intermediateCatchEvent>
    <exclusiveGateway id="Gateway_0cmxftd">
      <incoming>Flow_1hwf1uf</incoming>
      <outgoing>Flow_0mom0iz</outgoing>
      <outgoing>Flow_0q6k1w3</outgoing>
    </exclusiveGateway>
    <task id="Activity_StoreTripNoWeather" name="Store Trip without weather">
      <incoming>Flow_0q6k1w3</incoming>
      <outgoing>Flow_S8</outgoing>
    </task>
    <task id="Activity_EnrichTrip" name="Enrich trip with weather">
      <incoming>Flow_0mom0iz</incoming>
      <outgoing>Flow_S6</outgoing>
    </task>
    <task id="Activity_StoreTripWithWeather" name="Store Enriched Trip">
      <incoming>Flow_S6</incoming>
      <outgoing>Flow_S7</outgoing>
    </task>
    <sequenceFlow id="Flow_S1" sourceRef="Event_ReceiveTripData" targetRef="Activity_ValidateTrip" />
    <sequenceFlow id="Flow_S2" sourceRef="Activity_ValidateTrip" targetRef="Activity_RequestWeather" />
    <sequenceFlow id="Flow_S10" sourceRef="Activity_ConfirmEnrichment" targetRef="Event_SystemEnd" />
    <sequenceFlow id="Flow_S9" sourceRef="Gateway_Merge" targetRef="Activity_ConfirmEnrichment" />
    <sequenceFlow id="Flow_S7" sourceRef="Activity_StoreTripWithWeather" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_S8" sourceRef="Activity_StoreTripNoWeather" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_S4" sourceRef="Activity_RequestWeather" targetRef="Event_ReceiveWeatherData" />
    <sequenceFlow id="Flow_1hwf1uf" sourceRef="Event_ReceiveWeatherData" targetRef="Gateway_0cmxftd" />
    <sequenceFlow id="Flow_0mom0iz" sourceRef="Gateway_0cmxftd" targetRef="Activity_EnrichTrip" />
    <sequenceFlow id="Flow_0q6k1w3" sourceRef="Gateway_0cmxftd" targetRef="Activity_StoreTripNoWeather" />
    <sequenceFlow id="Flow_S6" sourceRef="Activity_EnrichTrip" targetRef="Activity_StoreTripWithWeather" />
  </process>
  <process id="Process_WeatherService" isExecutable="false">
    <intermediateCatchEvent id="Event_ReceiveWeatherRequest">
      <outgoing>Flow_W1</outgoing>
      <messageEventDefinition id="MessageEventDefinition_4" />
    </intermediateCatchEvent>
    <task id="Activity_CheckAvailability" name="Check Data Availability">
      <incoming>Flow_W1</incoming>
      <outgoing>Flow_W2</outgoing>
    </task>
    <exclusiveGateway id="Gateway_DataAvailable" name="Data available?">
      <incoming>Flow_W2</incoming>
      <outgoing>Flow_W3_Yes</outgoing>
      <outgoing>Flow_W3_No</outgoing>
    </exclusiveGateway>
    <task id="Activity_FetchWeather" name="Fetch Weather Data (temp, rain, wind)">
      <incoming>Flow_W3_Yes</incoming>
      <outgoing>Flow_W4</outgoing>
    </task>
    <exclusiveGateway id="Gateway_ResponseMerge">
      <incoming>Flow_W4</incoming>
      <incoming>Flow_W3_No</incoming>
      <outgoing>Flow_W6</outgoing>
    </exclusiveGateway>
    <task id="Activity_ProvideWeather" name="Send Weather Response">
      <incoming>Flow_W6</incoming>
      <outgoing>Flow_W7</outgoing>
    </task>
    <endEvent id="Event_WeatherEnd">
      <incoming>Flow_W7</incoming>
    </endEvent>
    <sequenceFlow id="Flow_W1" sourceRef="Event_ReceiveWeatherRequest" targetRef="Activity_CheckAvailability" />
    <sequenceFlow id="Flow_W2" sourceRef="Activity_CheckAvailability" targetRef="Gateway_DataAvailable" />
    <sequenceFlow id="Flow_W3_Yes" name="Yes" sourceRef="Gateway_DataAvailable" targetRef="Activity_FetchWeather" />
    <sequenceFlow id="Flow_W3_No" name="No" sourceRef="Gateway_DataAvailable" targetRef="Gateway_ResponseMerge" />
    <sequenceFlow id="Flow_W4" sourceRef="Activity_FetchWeather" targetRef="Gateway_ResponseMerge" />
    <sequenceFlow id="Flow_W6" sourceRef="Gateway_ResponseMerge" targetRef="Activity_ProvideWeather" />
    <sequenceFlow id="Flow_W7" sourceRef="Activity_ProvideWeather" targetRef="Event_WeatherEnd" />
  </process>
