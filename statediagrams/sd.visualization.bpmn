      <bpmndi:BPMNEdge id="MessageFlow_MapRequest_BBP_Map_di" bpmnElement="MessageFlow_MapRequest_BBP_Map">
        <di:waypoint x="438" y="574" />
        <di:waypoint x="438" y="840" />
