<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_ManualTripRecording_V2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0">
  <collaboration id="Collaboration_TripRecording_V2" name="Manual Trip Recording">
    <participant id="Participant_RegisteredUser" name="Registered User" processRef="Process_RegisteredUser" />
    <participant id="Participant_BBPSystem" name="BBP System" processRef="Process_BBPSystem" />
    <messageFlow id="Flow_StartRecording" sourceRef="Task_StartRecording" targetRef="Event_ReceiveStartRequest" />
    <messageFlow id="Flow_StopRecording" sourceRef="Task_StopRecording" targetRef="Event_ReceiveStopTrip" />
    <messageFlow id="Flow_ConfirmData" sourceRef="Event_SendConfirmation" targetRef="Event_ReceiveConfirmation" />
    <messageFlow id="Flow_SaveOnlyRequest" sourceRef="Event_SendSaveRequest" targetRef="Event_ReceiveSaveRequest" />
    <messageFlow id="Flow_PublishOnlyRequest" sourceRef="Event_SendPublishRequest" targetRef="Event_ReceivePublishRequest" />
    <messageFlow id="Flow_SaveAndPublishRequest" sourceRef="Event_SendSaveAndPublishRequest" targetRef="Event_ReceiveSaveAndPublishRequest" />
    <messageFlow id="Flow_DiscardRequest" sourceRef="Event_SendDiscardRequest" targetRef="Event_ReceiveDiscardRequest" />
    <messageFlow id="Flow_SuccessConfirmation" sourceRef="Event_SendSuccess" targetRef="Event_ReceiveSuccess" />
    <messageFlow id="Flow_0n0xua2" sourceRef="Event_SendReviewData" targetRef="Event_ReceiveReviewData" />
  </collaboration>
  <process id="Process_RegisteredUser" name="Registered User Process" isExecutable="false">
    <startEvent id="StartEvent_RU" name="Want to record trip">
      <outgoing>Flow_01</outgoing>
    </startEvent>
    <sequenceFlow id="Flow_01" sourceRef="StartEvent_RU" targetRef="Task_StartRecording" />
    <task id="Task_StartRecording" name="Start trip recording">
      <incoming>Flow_01</incoming>
      <outgoing>Flow_02</outgoing>
    </task>
    <sequenceFlow id="Flow_02" sourceRef="Task_StartRecording" targetRef="Task_BikeTrip" />
    <task id="Task_BikeTrip" name="Bike trip (GPS and sensor data collected)">
      <incoming>Flow_02</incoming>
      <outgoing>Flow_03</outgoing>
    </task>
    <sequenceFlow id="Flow_03" sourceRef="Task_BikeTrip" targetRef="Task_StopRecording" />
    <sequenceFlow id="Flow_04" sourceRef="Task_StopRecording" targetRef="Event_ReceiveReviewData" />
    <sequenceFlow id="Flow_05" sourceRef="Event_ReceiveReviewData" targetRef="Task_ReviewData" />
    <userTask id="Task_ReviewData" name="Review and correct trip data">
      <incoming>Flow_05</incoming>
      <outgoing>Flow_06</outgoing>
    </userTask>
    <sequenceFlow id="Flow_06" sourceRef="Task_ReviewData" targetRef="Event_SendConfirmation" />
    <intermediateThrowEvent id="Event_SendConfirmation" name="Confirm reviewed data">
      <incoming>Flow_06</incoming>
      <outgoing>Flow_07</outgoing>
      <messageEventDefinition />
    </intermediateThrowEvent>
    <sequenceFlow id="Flow_07" sourceRef="Event_SendConfirmation" targetRef="Gateway_Decision" />
    <exclusiveGateway id="Gateway_Decision" name="Action?">
      <incoming>Flow_07</incoming>
      <outgoing>Flow_SaveOnly</outgoing>
      <outgoing>Flow_PublishOnly</outgoing>
      <outgoing>Flow_SaveAndPublish</outgoing>
      <outgoing>Flow_Discard</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="Flow_SaveOnly" name="Save as Trip only" sourceRef="Gateway_Decision" targetRef="Event_SendSaveRequest">
      <conditionExpression xsi:type="tFormalExpression">#{decision == 'saveOnly'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_WaitSave" sourceRef="Event_SendSaveRequest" targetRef="Gateway_0b106tb" />
    <sequenceFlow id="Flow_PublishOnly" name="Publish as BikePath only" sourceRef="Gateway_Decision" targetRef="Event_SendPublishRequest">
      <conditionExpression xsi:type="tFormalExpression">#{decision == 'publishOnly'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_SaveAndPublish" name="Save &#38; Publish" sourceRef="Gateway_Decision" targetRef="Event_SendSaveAndPublishRequest">
      <conditionExpression xsi:type="tFormalExpression">#{decision == 'saveAndPublish'}</conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="Flow_Discard" name="Discard" sourceRef="Gateway_Decision" targetRef="Event_SendDiscardRequest">
      <conditionExpression xsi:type="tFormalExpression">#{decision == 'discard'}</conditionExpression>
    </sequenceFlow>
    <task id="Task_StopRecording" name="Stop trip recording">
      <incoming>Flow_03</incoming>
      <outgoing>Flow_04</outgoing>
    </task>
    <intermediateCatchEvent id="Event_ReceiveReviewData" name="Receive trip data for review">
      <incoming>Flow_04</incoming>
      <outgoing>Flow_05</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <intermediateThrowEvent id="Event_SendDiscardRequest" name="Send discard request">
      <incoming>Flow_Discard</incoming>
      <outgoing>Flow_0jxixw3</outgoing>
      <messageEventDefinition />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="Event_SendSaveRequest" name="Send save request">
      <incoming>Flow_SaveOnly</incoming>
      <outgoing>Flow_WaitSave</outgoing>
      <messageEventDefinition />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="Event_SendPublishRequest" name="Send publish request">
      <incoming>Flow_PublishOnly</incoming>
      <outgoing>Flow_021kxce</outgoing>
      <messageEventDefinition />
    </intermediateThrowEvent>
    <intermediateThrowEvent id="Event_SendSaveAndPublishRequest" name="Send request">
      <incoming>Flow_SaveAndPublish</incoming>
      <outgoing>Flow_19fem37</outgoing>
      <messageEventDefinition />
    </intermediateThrowEvent>
    <intermediateCatchEvent id="Event_ReceiveSuccess" name="Receive success confirmation">
      <incoming>Flow_1wu9qul</incoming>
      <outgoing>Flow_ToEnd</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <sequenceFlow id="Flow_ToEnd" sourceRef="Event_ReceiveSuccess" targetRef="EndEvent_RU" />
    <endEvent id="EndEvent_RU" name="End session">
      <incoming>Flow_ToEnd</incoming>
    </endEvent>
    <exclusiveGateway id="Gateway_0b106tb" name="">
      <incoming>Flow_WaitSave</incoming>
      <incoming>Flow_021kxce</incoming>
      <incoming>Flow_19fem37</incoming>
      <incoming>Flow_0jxixw3</incoming>
      <outgoing>Flow_1wu9qul</outgoing>
    </exclusiveGateway>
    <sequenceFlow id="Flow_1wu9qul" sourceRef="Gateway_0b106tb" targetRef="Event_ReceiveSuccess" />
    <sequenceFlow id="Flow_021kxce" sourceRef="Event_SendPublishRequest" targetRef="Gateway_0b106tb" />
    <sequenceFlow id="Flow_19fem37" sourceRef="Event_SendSaveAndPublishRequest" targetRef="Gateway_0b106tb" />
    <sequenceFlow id="Flow_0jxixw3" sourceRef="Event_SendDiscardRequest" targetRef="Gateway_0b106tb" />
  </process>
  <process id="Process_BBPSystem" name="BBP System Process" isExecutable="false">
    <startEvent id="Event_ReceiveStartRequest" name="Receive start request">
      <outgoing>Flow_B01</outgoing>
      <messageEventDefinition />
    </startEvent>
    <sequenceFlow id="Flow_B01" sourceRef="Event_ReceiveStartRequest" targetRef="Task_CollectGPSData" />
    <task id="Task_CollectGPSData" name="Start collecting GPS data">
      <incoming>Flow_B01</incoming>
      <outgoing>Flow_B02</outgoing>
    </task>
    <sequenceFlow id="Flow_B02" sourceRef="Task_CollectGPSData" targetRef="Task_CollectSensorData" />
    <sequenceFlow id="Flow_B03" sourceRef="Task_CollectSensorData" targetRef="Event_ReceiveStopTrip" />
    <sequenceFlow id="Flow_B09" sourceRef="Event_ReceiveConfirmation" targetRef="Gateway_RequestType" />
    <task id="Task_CollectSensorData" name="Collect sensor data (accelerometer, gyroscope) if enabled">
      <incoming>Flow_B02</incoming>
      <outgoing>Flow_B03</outgoing>
    </task>
    <sequenceFlow id="Flow_ToPublishOnly" sourceRef="Gateway_RequestType" targetRef="Event_ReceivePublishRequest" />
    <sequenceFlow id="Flow_ToSaveAndPublish" sourceRef="Gateway_RequestType" targetRef="Event_ReceiveSaveAndPublishRequest" />
    <sequenceFlow id="Flow_ToDiscard" sourceRef="Gateway_RequestType" targetRef="Event_ReceiveDiscardRequest" />
    <sequenceFlow id="Flow_B13" sourceRef="Task_CalculateScore" targetRef="Task_PublishBikePath" />
    <sequenceFlow id="Flow_B14" sourceRef="Task_PublishBikePath" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_B22" sourceRef="Event_ReceiveDiscardRequest" targetRef="Task_DeleteData" />
    <sequenceFlow id="Flow_B24" sourceRef="Gateway_Merge" targetRef="Event_SendSuccess" />
    <sequenceFlow id="Flow_B25" sourceRef="Event_SendSuccess" targetRef="EndEvent_BBP" />
    <intermediateCatchEvent id="Event_ReceiveDiscardRequest" name="Receive discard request">
      <incoming>Flow_ToDiscard</incoming>
      <outgoing>Flow_B22</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <intermediateCatchEvent id="Event_ReceiveStopTrip" name="Receive stop request">
      <incoming>Flow_B03</incoming>
      <outgoing>Flow_B04</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <task id="Task_ProcessTripData" name="Process trip data: calculate distance, speed, duration">
      <incoming>Flow_B04</incoming>
      <outgoing>Flow_B05</outgoing>
    </task>
    <task id="Task_AssignPathStatus" name="Assign suggested path status based on obstacles and route characteristics">
      <incoming>Flow_B05</incoming>
      <outgoing>Flow_1r6rn0n</outgoing>
    </task>
    <intermediateThrowEvent id="Event_SendReviewData" name="Send trip data with suggestions to user">
      <incoming>Flow_1r6rn0n</incoming>
      <outgoing>Flow_0gsozjd</outgoing>
      <messageEventDefinition />
    </intermediateThrowEvent>
    <intermediateCatchEvent id="Event_ReceiveConfirmation" name="Receive confirmed data">
      <incoming>Flow_0gsozjd</incoming>
      <outgoing>Flow_B09</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <sequenceFlow id="Flow_B04" sourceRef="Event_ReceiveStopTrip" targetRef="Task_ProcessTripData" />
    <sequenceFlow id="Flow_B05" sourceRef="Task_ProcessTripData" targetRef="Task_AssignPathStatus" />
    <sequenceFlow id="Flow_1r6rn0n" sourceRef="Task_AssignPathStatus" targetRef="Event_SendReviewData" />
    <sequenceFlow id="Flow_0gsozjd" sourceRef="Event_SendReviewData" targetRef="Event_ReceiveConfirmation" />
    <task id="Task_DeleteData" name="Delete collected data">
      <incoming>Flow_B22</incoming>
      <outgoing>Flow_1kveiy8</outgoing>
    </task>
    <sequenceFlow id="Flow_1q4srwm" sourceRef="Gateway_RequestType" targetRef="Event_ReceiveSaveRequest" />
    <exclusiveGateway id="Gateway_Merge" name="">
      <incoming>Flow_B14</incoming>
      <incoming>Flow_1u437nb</incoming>
      <incoming>Flow_1kveiy8</incoming>
      <outgoing>Flow_B24</outgoing>
    </exclusiveGateway>
    <intermediateCatchEvent id="Event_ReceiveSaveRequest" name="Receive save request">
      <incoming>Flow_1q4srwm</incoming>
      <outgoing>Flow_0eo2w5e</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <task id="Task_FetchWeatherData" name="Fetch weather data from external service (if available)">
      <incoming>Flow_0eo2w5e</incoming>
      <outgoing>Flow_1x41gr1</outgoing>
    </task>
    <sequenceFlow id="Flow_0eo2w5e" sourceRef="Event_ReceiveSaveRequest" targetRef="Task_FetchWeatherData" />
    <task id="Task_SavePersonalTrip" name="Save as personal Trip in database">
      <incoming>Flow_1x41gr1</incoming>
      <outgoing>Flow_1u437nb</outgoing>
    </task>
    <sequenceFlow id="Flow_1x41gr1" sourceRef="Task_FetchWeatherData" targetRef="Task_SavePersonalTrip" />
    <sequenceFlow id="Flow_1u437nb" sourceRef="Task_SavePersonalTrip" targetRef="Gateway_Merge" />
    <sequenceFlow id="Flow_0voqfcg" sourceRef="Event_ReceiveSaveAndPublishRequest" targetRef="Activity_1oq88y0" />
    <sequenceFlow id="Flow_0elhn1g" sourceRef="Activity_1oq88y0" targetRef="Gateway_Split" />
    <eventBasedGateway id="Gateway_RequestType" name="">
      <incoming>Flow_B09</incoming>
      <outgoing>Flow_ToPublishOnly</outgoing>
      <outgoing>Flow_ToSaveAndPublish</outgoing>
      <outgoing>Flow_ToDiscard</outgoing>
      <outgoing>Flow_1q4srwm</outgoing>
    </eventBasedGateway>
    <intermediateCatchEvent id="Event_ReceiveSaveAndPublishRequest" name="Receive save&#38;publish request">
      <incoming>Flow_ToSaveAndPublish</incoming>
      <outgoing>Flow_0voqfcg</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <task id="Activity_1oq88y0" name="Fetch weather data from external service (if available)">
      <incoming>Flow_0voqfcg</incoming>
      <outgoing>Flow_0elhn1g</outgoing>
    </task>
    <parallelGateway id="Gateway_Split">
      <incoming>Flow_0elhn1g</incoming>
      <outgoing>Flow_0a1cew3</outgoing>
      <outgoing>Flow_0d2zdcu</outgoing>
    </parallelGateway>
    <intermediateCatchEvent id="Event_ReceivePublishRequest" name="Receive publish request">
      <incoming>Flow_ToPublishOnly</incoming>
      <outgoing>Flow_0j1ef3r</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <task id="Task_CalculateScore" name="Calculate path score">
      <incoming>Flow_0j1ef3r</incoming>
      <outgoing>Flow_B13</outgoing>
    </task>
    <sequenceFlow id="Flow_0j1ef3r" sourceRef="Event_ReceivePublishRequest" targetRef="Task_CalculateScore" />
    <sequenceFlow id="Flow_0a1cew3" sourceRef="Gateway_Split" targetRef="Activity_1gi6h0t" />
    <task id="Activity_1gi6h0t" name="Save as personal Trip in database">
      <incoming>Flow_0a1cew3</incoming>
      <outgoing>Flow_1qu8600</outgoing>
    </task>
    <task id="Task_PublishBikePath" name="Publish as BikePath">
      <incoming>Flow_B13</incoming>
      <incoming>Flow_1puett9</incoming>
      <outgoing>Flow_B14</outgoing>
    </task>
    <sequenceFlow id="Flow_1iaec63" sourceRef="Activity_0uact48" targetRef="Activity_0wgaky2" />
    <sequenceFlow id="Flow_0d2zdcu" sourceRef="Gateway_Split" targetRef="Activity_0uact48" />
    <task id="Activity_0uact48" name="Calculate path score">
      <incoming>Flow_0d2zdcu</incoming>
      <outgoing>Flow_1iaec63</outgoing>
    </task>
    <task id="Activity_0wgaky2" name="Publish as BikePath (make available to community)">
      <incoming>Flow_1iaec63</incoming>
      <outgoing>Flow_0xj9ojo</outgoing>
    </task>
    <parallelGateway id="Gateway_11dpqbg">
      <incoming>Flow_1qu8600</incoming>
      <incoming>Flow_0xj9ojo</incoming>
      <outgoing>Flow_1puett9</outgoing>
    </parallelGateway>
    <sequenceFlow id="Flow_1qu8600" sourceRef="Activity_1gi6h0t" targetRef="Gateway_11dpqbg" />
    <sequenceFlow id="Flow_0xj9ojo" sourceRef="Activity_0wgaky2" targetRef="Gateway_11dpqbg" />
    <sequenceFlow id="Flow_1puett9" sourceRef="Gateway_11dpqbg" targetRef="Task_PublishBikePath" />
    <intermediateThrowEvent id="Event_SendSuccess" name="Send success confirmation">
      <incoming>Flow_B24</incoming>
      <outgoing>Flow_B25</outgoing>
      <messageEventDefinition />
    </intermediateThrowEvent>
    <endEvent id="EndEvent_BBP" name="End session">
      <incoming>Flow_B25</incoming>
    </endEvent>
    <sequenceFlow id="Flow_1kveiy8" sourceRef="Task_DeleteData" targetRef="Gateway_Merge" />
  </process>
