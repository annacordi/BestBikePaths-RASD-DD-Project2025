    <sequenceFlow id="Flow_ConfirmedYes" sourceRef="GW_Confirmed" targetRef="Task_StoreObstacle" />
    <sequenceFlow id="Flow_ConfirmedNo" sourceRef="GW_Confirmed" targetRef="Task_DiscardObstacle" />
    <sequenceFlow id="Flow_0e9xz65" sourceRef="Task_StoreObstacle" targetRef="Gateway_0na0fum" />
    <sequenceFlow id="Flow_0elb9dk" sourceRef="Task_DiscardObstacle" targetRef="Gateway_0na0fum" />
    <sequenceFlow id="Flow_1pi0wob" sourceRef="Gateway_0jmoajz" targetRef="Event_ReceiveModifiedData" />
    <sequenceFlow id="Flow_B11" sourceRef="Event_ReceiveModifiedData" targetRef="Task_StoreModifications" />
    <sequenceFlow id="Flow_B12" sourceRef="Task_StoreModifications" targetRef="Task_PrepareConfirmedData" />
    <sequenceFlow id="Flow_B13" sourceRef="Task_PrepareConfirmedData" targetRef="Task_AcknowledgeConfirmation" />
    <sequenceFlow id="Flow_1r36490" sourceRef="Task_AcknowledgeConfirmation" targetRef="Gateway_075euj8" />
    <sequenceFlow id="Flow_08okrha" sourceRef="Gateway_0na0fum" targetRef="Gateway_0jmoajz" />
