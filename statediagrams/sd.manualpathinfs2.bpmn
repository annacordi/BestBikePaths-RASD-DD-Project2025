    </endEvent>
    <sequenceFlow id="Flow_Start_Validate" sourceRef="Event_ReceivePathData" targetRef="Task_ValidatePathData" />
    <sequenceFlow id="Flow_Validate_Gateway1" sourceRef="Task_ValidatePathData" targetRef="Gateway_IsValid" />
