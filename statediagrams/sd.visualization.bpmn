      <bpmndi:BPMNEdge id="MessageFlow_MapData_di" bpmnElement="MessageFlow_MapData">
        <di:waypoint x="680" y="840" />
        <di:waypoint x="680" y="574" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="668" y="688" width="59" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="MessageFlow_SendVisualResponse_di" bpmnElement="MessageFlow_SendVisualResponse">
        <di:waypoint x="940" y="538" />
        <di:waypoint x="940" y="256" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="947" y="396" width="81" height="27" />
        </bpmndi:BPMNLabel>
