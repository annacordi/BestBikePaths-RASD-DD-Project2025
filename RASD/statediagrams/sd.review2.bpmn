<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" id="Definitions_DataReview" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.41.0">
  <collaboration id="Collab_DataReview">
    <participant id="Participant_User" name="Registered User" processRef="Process_User" />
    <participant id="Participant_BBP" name="BBP System" processRef="Process_BBP" />
    <messageFlow id="MF_SendCollectedData" sourceRef="Task_SendCollectedData" targetRef="Event_ReceiveData" />
    <messageFlow id="Flow_1w0kbt5" sourceRef="Activity_1g04l3h" targetRef="Event_ReceiveDecision" />
    <messageFlow id="Flow_0z0a5pb" sourceRef="Activity_1ns613j" targetRef="Event_01t6xt2" />
    <messageFlow id="Flow_1xqdn9j" sourceRef="Activity_08oibuz" targetRef="Event_01t6xt2" />
    <messageFlow id="Flow_00q51dg" sourceRef="Activity_1i7jgz8" targetRef="Event_01t6xt2" />
    <messageFlow id="Flow_1rbwlia" sourceRef="Task_AcknowledgeConfirmation" targetRef="Event_ReceiveConfirmation" />
  </collaboration>
  <process id="Process_User" name="User Process" isExecutable="false">
    <startEvent id="Start_User" name="User opens the notification">
      <outgoing>Flow_U1</outgoing>
    </startEvent>
    <intermediateCatchEvent id="Event_ReceiveData" name="Receive collected data">
      <incoming>Flow_U1</incoming>
      <outgoing>Flow_U2</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <task id="Task_ViewTripDetails" name="View trip details">
      <incoming>Flow_U2</incoming>
      <outgoing>Flow_U3</outgoing>
    </task>
    <task id="Task_ReviewBasicData" name="Review origin, destination, street names, path status">
      <incoming>Flow_U3</incoming>
      <outgoing>Flow_U4</outgoing>
    </task>
    <exclusiveGateway id="GW_BasicDataOK" name="Basic data correct?">
      <incoming>Flow_U4</incoming>
      <outgoing>Flow_BasicYes</outgoing>
      <outgoing>Flow_BasicNo</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GW_MergeBasic" name="">
      <incoming>Flow_BasicYes</incoming>
      <incoming>Flow_0b6b3qu</incoming>
      <outgoing>Flow_U6</outgoing>
    </exclusiveGateway>
    <sendTask id="Activity_1g04l3h" name="Modify the incorrect data">
      <incoming>Flow_BasicNo</incoming>
      <outgoing>Flow_0b6b3qu</outgoing>
    </sendTask>
    <subProcess id="SubProcess_ObstacleReview" name="Review Obstacles">
      <incoming>Flow_U6</incoming>
      <outgoing>Flow_U15</outgoing>
      <startEvent id="Start_SubProc" name="View obstacles list">
        <outgoing>Flow_SP1</outgoing>
      </startEvent>
      <exclusiveGateway id="GW_ObstacleDecision">
        <incoming>Flow_1pl5wb4</incoming>
        <outgoing>Flow_0dxyfkg</outgoing>
        <outgoing>Flow_0swmo0k</outgoing>
        <outgoing>Flow_04gt6m9</outgoing>
      </exclusiveGateway>
      <exclusiveGateway id="GW_MergeObstacle" name="">
        <incoming>Flow_0w9mo63</incoming>
        <incoming>Flow_0q6xvxz</incoming>
        <incoming>Flow_0u38wpa</incoming>
        <outgoing>Flow_SP6</outgoing>
      </exclusiveGateway>
      <exclusiveGateway id="GW_MoreObstacles" name="More obstacles?">
        <incoming>Flow_SP6</incoming>
        <outgoing>Flow_SP7</outgoing>
        <outgoing>Flow_SP_Loop</outgoing>
      </exclusiveGateway>
      <endEvent id="End_SubProc" name="All obstacles reviewed">
        <incoming>Flow_SP7</incoming>
      </endEvent>
      <sequenceFlow id="Flow_SP6" sourceRef="GW_MergeObstacle" targetRef="GW_MoreObstacles" />
      <sequenceFlow id="Flow_SP7" name="No" sourceRef="GW_MoreObstacles" targetRef="End_SubProc" />
      <sequenceFlow id="Flow_SP_Loop" sourceRef="GW_MoreObstacles" targetRef="Activity_1uzbh8u" />
      <sequenceFlow id="Flow_SP1" sourceRef="Start_SubProc" targetRef="Activity_1uzbh8u" />
      <userTask id="Activity_1uzbh8u" name="Review obstacle position and type">
        <incoming>Flow_SP_Loop</incoming>
        <incoming>Flow_SP1</incoming>
        <outgoing>Flow_1pl5wb4</outgoing>
      </userTask>
      <sequenceFlow id="Flow_1pl5wb4" sourceRef="Activity_1uzbh8u" targetRef="GW_ObstacleDecision" />
      <sendTask id="Activity_1i7jgz8" name="Confirm obstacle">
        <incoming>Flow_0dxyfkg</incoming>
        <outgoing>Flow_0w9mo63</outgoing>
      </sendTask>
      <sequenceFlow id="Flow_0dxyfkg" sourceRef="GW_ObstacleDecision" targetRef="Activity_1i7jgz8" />
      <sendTask id="Activity_08oibuz" name="Reject obstacle">
        <incoming>Flow_0swmo0k</incoming>
        <outgoing>Flow_0q6xvxz</outgoing>
      </sendTask>
      <sequenceFlow id="Flow_0swmo0k" sourceRef="GW_ObstacleDecision" targetRef="Activity_08oibuz" />
      <sequenceFlow id="Flow_0w9mo63" sourceRef="Activity_1i7jgz8" targetRef="GW_MergeObstacle" />
      <sequenceFlow id="Flow_0q6xvxz" sourceRef="Activity_08oibuz" targetRef="GW_MergeObstacle" />
      <userTask id="Activity_1eh4ocr" name="Modify data">
        <incoming>Flow_04gt6m9</incoming>
        <outgoing>Flow_1ou79so</outgoing>
      </userTask>
      <sequenceFlow id="Flow_04gt6m9" sourceRef="GW_ObstacleDecision" targetRef="Activity_1eh4ocr" />
      <sendTask id="Activity_1ns613j" name="Send modification">
        <incoming>Flow_1ou79so</incoming>
        <outgoing>Flow_0u38wpa</outgoing>
      </sendTask>
      <sequenceFlow id="Flow_1ou79so" sourceRef="Activity_1eh4ocr" targetRef="Activity_1ns613j" />
      <sequenceFlow id="Flow_0u38wpa" sourceRef="Activity_1ns613j" targetRef="GW_MergeObstacle" />
    </subProcess>
    <sequenceFlow id="Flow_U1" sourceRef="Start_User" targetRef="Event_ReceiveData" />
    <sequenceFlow id="Flow_U2" sourceRef="Event_ReceiveData" targetRef="Task_ViewTripDetails" />
    <sequenceFlow id="Flow_U3" sourceRef="Task_ViewTripDetails" targetRef="Task_ReviewBasicData" />
    <sequenceFlow id="Flow_U4" sourceRef="Task_ReviewBasicData" targetRef="GW_BasicDataOK" />
    <sequenceFlow id="Flow_BasicYes" name="Yes" sourceRef="GW_BasicDataOK" targetRef="GW_MergeBasic" />
    <sequenceFlow id="Flow_BasicNo" name="No" sourceRef="GW_BasicDataOK" targetRef="Activity_1g04l3h" />
    <sequenceFlow id="Flow_0b6b3qu" sourceRef="Activity_1g04l3h" targetRef="GW_MergeBasic" />
    <sequenceFlow id="Flow_U6" sourceRef="GW_MergeBasic" targetRef="SubProcess_ObstacleReview" />
    <sequenceFlow id="Flow_U15" sourceRef="SubProcess_ObstacleReview" targetRef="GW_OtherModifications" />
    <exclusiveGateway id="GW_OtherModifications" name="Other modifications needed?">
      <incoming>Flow_U15</incoming>
      <outgoing>Flow_OtherNo</outgoing>
      <outgoing>Flow_164wjr6</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="GW_MergeFinal" name="">
      <incoming>Flow_OtherNo</incoming>
      <incoming>Flow_11zrv5j</incoming>
      <outgoing>Flow_U17</outgoing>
    </exclusiveGateway>
    <endEvent id="End_User" name="Data review completed">
      <incoming>Flow_U17</incoming>
    </endEvent>
    <sendTask id="Activity_0zia4kr" name="Send additional modifications">
      <incoming>Flow_164wjr6</incoming>
      <outgoing>Flow_1rrgp4e</outgoing>
    </sendTask>
    <intermediateCatchEvent id="Event_ReceiveConfirmation" name="Receive confirmation">
      <incoming>Flow_1rrgp4e</incoming>
      <outgoing>Flow_11zrv5j</outgoing>
      <messageEventDefinition id="MessageEventDefinition_1if7ao9" />
    </intermediateCatchEvent>
    <sequenceFlow id="Flow_OtherNo" name="No" sourceRef="GW_OtherModifications" targetRef="GW_MergeFinal" />
    <sequenceFlow id="Flow_164wjr6" sourceRef="GW_OtherModifications" targetRef="Activity_0zia4kr" />
    <sequenceFlow id="Flow_11zrv5j" sourceRef="Event_ReceiveConfirmation" targetRef="GW_MergeFinal" />
    <sequenceFlow id="Flow_U17" sourceRef="GW_MergeFinal" targetRef="End_User" />
    <sequenceFlow id="Flow_1rrgp4e" sourceRef="Activity_0zia4kr" targetRef="Event_ReceiveConfirmation" />
  </process>
  <process id="Process_BBP" name="BBP System Process" isExecutable="false">
    <startEvent id="Start_BBP" name="Trip recorded or detected">
      <outgoing>Flow_B1</outgoing>
    </startEvent>
    <sendTask id="Task_SendCollectedData" name="Send all data for review">
      <incoming>Flow_B1</incoming>
      <outgoing>Flow_1n5mo6z</outgoing>
    </sendTask>
    <intermediateCatchEvent id="Event_ReceiveDecision" name="Receive data corrected">
      <incoming>Flow_1n5mo6z</incoming>
      <outgoing>Flow_0ybt875</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <task id="Activity_142om15" name="Store data">
      <incoming>Flow_0ybt875</incoming>
      <outgoing>Flow_1vdesi2</outgoing>
    </task>
    <exclusiveGateway id="GW_Confirmed">
      <incoming>Flow_1hqipmu</incoming>
      <outgoing>Flow_ConfirmedYes</outgoing>
      <outgoing>Flow_ConfirmedNo</outgoing>
    </exclusiveGateway>
    <task id="Task_StoreObstacle" name="Store confirmed/ modifed obstacle">
      <incoming>Flow_ConfirmedYes</incoming>
      <outgoing>Flow_0e9xz65</outgoing>
    </task>
    <task id="Task_DiscardObstacle" name="Discard rejected obstacle">
      <incoming>Flow_ConfirmedNo</incoming>
      <outgoing>Flow_0elb9dk</outgoing>
    </task>
    <intermediateCatchEvent id="Event_ReceiveModifiedData" name="Receive other modifications">
      <incoming>Flow_1pi0wob</incoming>
      <outgoing>Flow_B11</outgoing>
      <messageEventDefinition />
    </intermediateCatchEvent>
    <task id="Task_StoreModifications" name="Store modifications">
      <incoming>Flow_B11</incoming>
      <outgoing>Flow_B12</outgoing>
    </task>
    <task id="Task_PrepareConfirmedData" name="Prepare confirmed data">
      <incoming>Flow_B12</incoming>
      <outgoing>Flow_B13</outgoing>
    </task>
    <sendTask id="Task_AcknowledgeConfirmation" name="Send confirmation">
      <incoming>Flow_B13</incoming>
      <outgoing>Flow_1r36490</outgoing>
    </sendTask>
    <intermediateCatchEvent id="Event_01t6xt2" name="Receive user action">
      <incoming>Flow_1vdesi2</incoming>
      <outgoing>Flow_1hqipmu</outgoing>
      <messageEventDefinition id="MessageEventDefinition_0hvn5rw" />
    </intermediateCatchEvent>
    <exclusiveGateway id="Gateway_0na0fum">
      <incoming>Flow_0e9xz65</incoming>
      <incoming>Flow_0elb9dk</incoming>
      <outgoing>Flow_08okrha</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_0jmoajz">
      <incoming>Flow_08okrha</incoming>
      <outgoing>Flow_1pi0wob</outgoing>
      <outgoing>Flow_1f7lqxr</outgoing>
    </exclusiveGateway>
    <exclusiveGateway id="Gateway_075euj8">
      <incoming>Flow_1f7lqxr</incoming>
      <incoming>Flow_1r36490</incoming>
      <outgoing>Flow_0kdonpp</outgoing>
    </exclusiveGateway>
    <endEvent id="Event_0754yqa">
      <incoming>Flow_0kdonpp</incoming>
    </endEvent>
    <sequenceFlow id="Flow_B1" sourceRef="Start_BBP" targetRef="Task_SendCollectedData" />
    <sequenceFlow id="Flow_1n5mo6z" sourceRef="Task_SendCollectedData" targetRef="Event_ReceiveDecision" />
