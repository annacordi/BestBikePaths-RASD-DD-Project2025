  <process id="Process_BBPSystem" name="BBP System Process" isExecutable="false">
    <intermediateCatchEvent id="Event_ReceivePathData" name="Receive path data">
      <outgoing>Flow_Start_Validate</outgoing>
      <messageEventDefinition />
